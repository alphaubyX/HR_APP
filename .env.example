# Copy to ".env" and fill in. ".env" is never committed to git.
# On cPanel (FastComet) you can instead enter these under Setup Node.js App → Environment variables.

# ---- Database: MySQL / MariaDB (recommended for production) ----
HR_DB_CLIENT=mysql
HR_DB_HOST=localhost
HR_DB_PORT=3306
HR_DB_NAME=cpaneluser_hr
HR_DB_USER=cpaneluser_hr
HR_DB_PASSWORD=change-me
# For a quick local trial without MySQL, use SQLite instead (needs Node.js 22.13+):
# HR_DB_CLIENT=sqlite
# HR_SQLITE_FILE=./data/hr.db

# Uploaded employee documents and candidates' CVs are stored here. Keep it OUTSIDE the app folder on a server.
HR_DATA_DIR=./data

# ---- The server owner (you): created on first start, manages every organization ----
HR_OWNER_USERNAME=admin
HR_OWNER_PASSWORD=change-me-please
HR_OWNER_NAME=Admin
# Name of the first organization, created on first start (you can rename it later)
HR_ORG_NAME=My Company
# Set to true for one start to reset the owner password above, then back to false.
HR_OWNER_RESET_PASSWORD=false

# AI helper for recruitment (reads CVs, summarizes and advises). Get a key at https://console.anthropic.com
# Leave empty to switch the AI helper off. CVs are sent to Anthropic's API only when someone clicks "Read CV with AI".
ANTHROPIC_API_KEY=
# HR_AI_MODEL=claude-opus-5-5

# Let companies create their own HR workspace at https://your-site/#signup (on | off)
HR_SIGNUP=off

# Single sign-on from the Broadwing suite (a long random secret shared with Broadwing). Leave empty to switch off.
BROADWING_SSO_SECRET=

# Set to 1 behind cPanel / nginx / any proxy that handles HTTPS (secure cookies; phones need HTTPS for GPS).
TRUST_PROXY=1

# Only used when you run it yourself; hosting panels choose the port.
PORT=3100

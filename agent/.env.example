# Your Broadwing HR address and the device key from Attendance → Machines & import → (machine) → Get key
HR_URL=https://hr.yourdomain.com
HR_DEVICE_KEY=bwd_paste_the_key_here

# The attendance machine on your office network
ZK_IP=192.168.1.201
ZK_PORT=4370

# How often to read the machine, in minutes
INTERVAL_MINUTES=5
